# Yosys synthesis script for SPI Top

# Read RTL
read_verilog -sv rtl/spi_master.sv
read_verilog -sv rtl/spi_slave.sv
read_verilog -sv rtl/spi_top.sv

# Set top module
hierarchy -top spi_top

# Generic synthesis
proc
opt
fsm
opt
memory
opt
techmap
opt

# Statistics
stat

# Write synthesized netlist
write_verilog reports/spi_top_synth.v